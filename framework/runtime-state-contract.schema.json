{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Runtime State Contract",
  "type": "object",
  "required": ["framework", "runtime_state"],
  "properties": {
    "framework": { "type": "string" },
    "runtime_state": {
      "type": "object",
      "required": ["required_fields", "status_values"],
      "properties": {
        "required_fields": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "status_values": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
