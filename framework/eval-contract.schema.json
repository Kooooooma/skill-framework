{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Eval Contract",
  "type": "object",
  "required": ["framework", "scenarios"],
  "properties": {
    "framework": { "type": "string" },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "prompt", "expected_behavior", "forbidden_behavior", "pass_criteria"],
        "properties": {
          "id": { "type": "string" },
          "prompt": { "type": "string" },
          "expected_behavior": {
            "type": "array",
            "items": { "type": "string" },
            "minItems": 1
          },
          "forbidden_behavior": {
            "type": "array",
            "items": { "type": "string" },
            "minItems": 1
          },
          "pass_criteria": {
            "type": "array",
            "items": { "type": "string" },
            "minItems": 1
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
